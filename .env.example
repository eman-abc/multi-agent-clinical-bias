# Phase 0 pipeline — example environment file.
# Copy to `.env` and fill in real values. NEVER commit `.env` itself or paste
# real secrets into chat/logs — only this .env.example (with placeholders)
# should ever be version-controlled or shared.

# ---------------------------------------------------------------------------
# Master toggle — controls every API-touching module in this project
# ---------------------------------------------------------------------------
# true  = all API calls are mocked (default; safe, costs nothing, no network)
# false = live calls are made using the credentials below
DRY_RUN=true

# ---------------------------------------------------------------------------
# Agent A (Carrier-Generator, Note-Writer, Note-Validator) — Module 4
# ---------------------------------------------------------------------------
# Standard OpenAI: leave OPENAI_BASE_URL unset, fill OPENAI_API_KEY normally.
# Azure OpenAI (temporary, while GPU/open-weight access is being set up):
# the `openai` Python SDK reads OPENAI_BASE_URL/OPENAI_API_KEY automatically,
# so setting these two is enough to reroute every crew_pipeline.py OpenAI()
# call to Azure with ZERO source code changes.
OPENAI_API_KEY=your-openai-or-azure-api-key-here
# OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1

# Which deployment/model Agent A uses. Default matches phase_0_complete_v3.md
# §1's pinned choice. Override to an Azure deployment name (e.g. one of your
# three available deployments) while OPENAI_BASE_URL points at Azure.
GENERATOR_MODEL_ID=gpt-4o-mini-2024-07-18
# Azure (example): gpt-5.4-mini | gpt-5.4-nano — confirm deployment names in your resource portal
# GENERATOR_MODEL_ID=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Agent B (open-weight models, Module 5) — vLLM/TGI serving, unchanged
# ---------------------------------------------------------------------------
# Default: local vLLM/TGI server, no key needed.
LOCAL_BASE_URL=http://localhost:8000/v1
# LOCAL_API_KEY is normally unset (vLLM/TGI need no key). Only set this if
# LOCAL_BASE_URL is temporarily pointed somewhere that DOES need a real key
# (e.g. Azure OpenAI, standing in for Agent B before GPU access is ready) --
# this does not touch or remove the vLLM/TGI code path, it's purely additive.
# LOCAL_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1
# LOCAL_API_KEY=your-azure-api-key-here

# Hugging Face token, for gated open-weight models (Llama-3.1-8B-Instruct,
# Gemma-2-9B-IT, Gemma-2-27B-IT). Not needed for the ungated ones (OLMo,
# Mistral) or while Agent B is temporarily rerouted to a commercial API.
HF_TOKEN=your-hf-token-here
